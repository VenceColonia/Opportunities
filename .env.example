# The $0 pipeline (scripts/run-pipeline.ts, run by GitHub Actions) needs no
# environment variables at all — it reads/writes data/*.json and calls no
# paid API.

# Optional, opt-in only (ARCHITECTURE.md §8, Path B). Needed only if you
# choose to run `npm run enrich:claude` yourself with your own API key.
# Never set this as a GitHub Actions secret used by the scheduled pipeline —
# that would make the automated run start costing money.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Tuning knobs for the deterministic pipeline (all optional, sensible
# defaults if unset).
CLOSING_SOON_THRESHOLD_DAYS=7
DEDUP_TRIGRAM_THRESHOLD=0.60

# Deploying the static export to a GitHub Pages *project* site
# (https://<user>.github.io/<repo>/) needs this set to "/<repo>" at build
# time; leave unset for a custom domain or a user/org root Pages site.
NEXT_BASE_PATH=
